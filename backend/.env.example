# Recipient email address for portfolio enquiries
CONTACT_EMAIL=your_mail@gmail.com

# SMTP Server details (e.g., smtp.gmail.com for Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Optional SMTP security setting (true if port 465, false if port 587 with STARTTLS)
EMAIL_USE_SSL=false

# Admin authentication secret for reviews management
ADMIN_SECRET=replace-with-a-strong-secret
